{block styles}
<link rel="stylesheet" href="{$basePath}/styles/priceList.css"/>
{/block}
{block content}

<div class="data-list price-lists">
    <a n:href="PriceList:detail" class="btn btn-primary">Create price list</a>
    <h1>Price lists</h1>
    <p>Total price lists: {$totalPriceListsCount}</p>
    <input type="text" id="price-lists-search" class="data-list-search" placeholder="Price list name"/>
    {if $totalPriceListsCount > 0}
    <div n:snippet="price-lists">
	<span class="data-list-count">Searched price lists: {$searchedPriceListsCount}</span>
	<div class="data-list-items-header">
	    <span>Name</span>
	    <span>Currency</span>
	    <span>VAT</span>
	    <span>Default</span>
	    <span></span>
	</div>
	<div class="data-list-items">
	    {foreach $priceLists as $priceList}
		<div class="data-list-item">
		    <span title="{$priceList->getName()}">{$priceList->getName()}</span>
		    <span>{$priceList->getCurrency()}</span>
		    <span>
			{if $priceList->getIsWithVAT()}
			    <span class="badge badge-info">With VAT</span>
			{else}
			    <span class="badge">Without VAT</span>
			{/if}
		    </span>
		    <span>
			{if $priceList->getIsDefault()}
			    <span class="badge badge-success">Default</span>
			{/if}
		    </span>
		    <a n:href="PriceList:detail, 'plid' => $priceList->getInternalID()">Detail</a>
		</div>
	    {/foreach}
	</div>

	<div class="data-list-pagination">
	    {if $page > 1}
		<button class="data-list-pagination-page-button price-list-page-button" data-page-number="{$page-1}">Previous</button>
	    {/if}

	    {if $page * $limit < $searchedPriceListsCount}
		<button class="data-list-pagination-page-button price-list-page-button" data-page-number="{$page+1}">Next</button>
	    {/if}
	</div>
    </div>
    {else}
    <div class="data-list-empty">No price lists yet. Create the first one!</div>
    {/if}
</div>

{/block content}
{block scripts}
    <script src="{$basePath}/scripts/priceList.js"></script>
{/block}
