{block styles}

{/block}
{block content}
<div class="detail-header">
    <a n:href="PriceList:default" class="btn btn-back">Back to list</a>
</div>
{form priceListDetailForm}
    <div class="section form-narrow">
	{if !empty($priceList)}
	    <h2>Price list detail</h2>
	{else}
	    <h2>Price list creation</h2>
	{/if}

	{input priceList-internalID}

	<div class="row">
	    <div class="col">
		{label priceList-name/}
		{input priceList-name}
	    </div>
	    <div class="col">
		{label priceList-currency/}
		{input priceList-currency}
	    </div>
	</div>
	<div class="row">
	    <div class="col">
		{label priceList-isWithVAT/}
		{input priceList-isWithVAT}
	    </div>
	    <div class="col">
		{label priceList-isDefault/}
		{input priceList-isDefault}
	    </div>
	</div>
    </div>

    <div class="buttons">
	{input submitPriceList, class => "btn btn-primary"}
	{if !empty($priceList)}
	    {input deletePriceList, class => "btn btn-danger"}
	{/if}
    </div>
{/form}

{/block content}
{block scripts}

{/block}
