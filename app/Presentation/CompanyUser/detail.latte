{block styles}

{/block}
{block content}
<div class="detail-header">
    <a n:href="CompanyUser:default" class="btn btn-back">Back to list</a>
</div>
{form userDetailForm}
    <div class="section form-narrow">
	{if !empty($companyUser)}
	    <h2>User detail</h2>
	{else}
	    <h2>User creation</h2>
	{/if}

	{input internalID}

	<h3>Credentials</h3>
	<div class="row">
	    <div class="col">
		{label name/}
		{input name}
	    </div>
	    <div class="col">
		{label email/}
		{input email}
	    </div>
	</div>
	<div class="row">
	    <div class="col">
		{label phone/}
		{input phone}
	    </div>
	    <div class="col">
		{label roles/}
		{input roles}
	    </div>
	</div>
	<div class="row">
	    <div class="col">
		{label password/}
		{input password}
	    </div>
	    <div class="col">
		{label isEnabled/}
		{input isEnabled}
	    </div>
	</div>
	<div class="row">
	    <div class="col">
		{label note/}
		{input note}
	    </div>
	</div>
    </div>

    <div class="buttons">
	{input submitCompanyUser, class => "btn btn-primary"}
	{if !empty($companyUser)}
	    {input deleteCompanyUser, class => "btn btn-danger"}
	{/if}
    </div>
{/form}

{/block content}
{block scripts}
    <script src="{$basePath}/scripts/companyUser.js"></script>
{/block}
